<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_sin_logo"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_guia_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="GUÍA DE ARCADIA"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold|italic"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" /> <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="20dp"
    app:layout_constraintTop_toBottomOf="@id/tv_guia_titulo"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido a ArcadiaGames. Aquí puedes gestionar tu catálogo gamer de forma premium."
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/> <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Catálogo"
            android:textColor="@color/Texto_Verde"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pulsa en cualquier juego para ver detalles, stock y opciones de compra o alquiler."
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Filtros"
            android:textColor="@color/Texto_Verde"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usa la barra de búsqueda superior o los chips de plataforma para encontrar lo que buscas al instante."
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
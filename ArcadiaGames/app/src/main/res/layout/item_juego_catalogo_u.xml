<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#252525">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_juego_portada"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <TextView
            android:id="@+id/tv_juego_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/tv_juego_precio"
            app:layout_constraintStart_toEndOf="@id/iv_juego_portada"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_juego_descripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tv_juego_titulo"
            app:layout_constraintStart_toStartOf="@id/tv_juego_titulo"
            app:layout_constraintTop_toBottomOf="@id/tv_juego_titulo" />

        <TextView
            android:id="@+id/tv_juego_categoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_juego_titulo"
            app:layout_constraintEnd_toEndOf="@id/tv_juego_titulo"
            app:layout_constraintTop_toBottomOf="@id/tv_juego_descripcion" />

        <TextView
            android:id="@+id/tv_juego_plataformas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tv_juego_titulo"
            app:layout_constraintEnd_toEndOf="@id/tv_juego_titulo"
            app:layout_constraintTop_toBottomOf="@id/tv_juego_categoria"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_juego_precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/precio_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="00.00€"
            android:textColor="@color/Texto_Verde"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
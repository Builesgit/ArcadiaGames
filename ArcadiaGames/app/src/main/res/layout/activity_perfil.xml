<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_sin_logo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo_perfil"
            android:layout_marginTop="30dp"
            app:shapeAppearanceOverlay="@style/CircleAppearance"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:padding="2dp"/>

        <TextView
            android:id="@+id/txtTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI PERFIL"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="#BBBBBB"
            android:textSize="18sp"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:id="@+id/layoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/btnGestionAdmins"
                style="@style/BotonMenuPersonalizado"
                android:text="Gestión Admins"
                android:visibility="gone"
                app:icon="@drawable/ico_inventario" />

            <Button
                android:id="@+id/btnReportes"
                style="@style/BotonMenuPersonalizado"
                android:text="Ver Reportes"
                app:icon="@drawable/ico_incidencias"
                />

            <Button
                android:id="@+id/btnInventario"
                style="@style/BotonMenuPersonalizado"
                android:text="Gestionar Inventario"
                app:icon="@drawable/ico_inventario" />

            <Button
                android:id="@+id/btnCrearProducto"
                style="@style/BotonMenuPersonalizado"
                android:text="Crear / Añadir Producto"
                app:icon="@drawable/ico_juego" />

            <Button
                android:id="@+id/btnGestionarIncidencias"
                style="@style/BotonMenuPersonalizado"
                android:text="Gestionar Incidencias"
                app:icon="@drawable/ico_incidencias" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/btnMisJuegos"
                style="@style/BotonMenuPersonalizado"
                android:text="Mis Juegos"
                app:icon="@drawable/ico_juego" />

            <Button
                android:id="@+id/btnSubirJuego"
                style="@style/BotonMenuPersonalizado"
                android:text="Subir Juego"
                app:icon="@drawable/ico_juego" />

            <Button
                android:id="@+id/btnIntercambios"
                style="@style/BotonMenuPersonalizado"
                android:text="Mis Intercambios"
                app:icon="@drawable/ico_intercambio" />

            <Button
                android:id="@+id/btnSoporteTecnico"
                style="@style/BotonMenuPersonalizado"
                android:text="Soporte Técnico"
                app:icon="@drawable/ico_incidencias" />

            <LinearLayout
                android:id="@+id/layoutCanjearCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCodigoAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Código de invitación Admin"
                    android:textColorHint="#888888"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FFEB3B"/>

                <Button
                    android:id="@+id/btnCanjearCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convertirse en Admin"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="#FFEB3B"/>


            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Sesión"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            app:cornerRadius="12dp"/>


    </LinearLayout>
</ScrollView>
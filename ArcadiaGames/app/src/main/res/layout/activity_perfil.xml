<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_sin_logo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo_sin_fondo"
            android:layout_marginTop="30dp"
            app:shapeAppearanceOverlay="@style/CircleAppearance"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:padding="2dp"/>

        <TextView
            android:id="@+id/txtTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_titulo"
            android:textColor="@color/Amarillo"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_nombre"
            android:textColor="#BBBBBB"
            android:textSize="18sp"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:id="@+id/layoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/btnGestionAdmins"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_gestion_admins"
                android:visibility="gone"
                app:icon="@drawable/ico_inventario" />

            <Button
                android:id="@+id/btnHistorial"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_historial"
                app:icon="@drawable/ico_incidencias" />

            <Button
                android:id="@+id/btnInventario"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_inventario"
                app:icon="@drawable/ico_inventario" />

            <Button
                android:id="@+id/btnCrearProducto"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_crear_product"
                app:icon="@drawable/ico_juego" />

            <Button
                android:id="@+id/btnGestionarIncidencias"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_gestion_incidencias"
                app:icon="@drawable/ico_incidencias" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <Button
                android:id="@+id/btnMisCompras"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_mis_compras"
                app:icon="@drawable/ico_juego" />

            <Button
                android:id="@+id/btnSoporteTecnico"
                style="@style/BotonMenuPersonalizado"
                android:text="@string/perfil_btn_soporte"
                app:icon="@drawable/ico_incidencias" />

            <Button
                android:id="@+id/btnAbrirDialogoAdmin"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FFC107"
                android:text="@string/perfil_btn_convertir_admin"
                android:textColor="#000000"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_lock_lock"
                app:iconTint="#000000"
                app:cornerRadius="20dp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perfil_btn_cerrar_sesion"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
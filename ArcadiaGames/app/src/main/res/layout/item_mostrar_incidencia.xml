<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/historial_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_icono_bg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#25324A">

        <ImageView
            android:id="@+id/iv_icono_tipo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ico_incidencias" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tema_incidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema de la incidencia"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="usuario@email.com"
            android:textColor="#FFC107"
            android:textSize="12sp"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/tv_descripcion_incidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Breve descripción del reporte..."
            android:textColor="#BBBBBB"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/tv_tag_tipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_otros"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="TIPO"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true" />
    </LinearLayout>

</LinearLayout>
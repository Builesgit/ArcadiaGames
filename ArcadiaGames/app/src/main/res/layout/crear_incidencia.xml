<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_sin_logo">

    <View
        android:id="@+id/headerOverlay"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="#CC334155"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textviewadmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="@string/incidencia_titulo"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/incidencia_subtitulo"
        android:textColor="#FFC107"
        android:alpha="0.8"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/textviewadmin"
        app:layout_constraintTop_toBottomOf="@id/textviewadmin" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/incidencia_asunto"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextLayoutTemaIncidencia"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="#334155"
                app:boxStrokeColor="#FFC107"
                app:hintEnabled="false"
                app:startIconDrawable="@android:drawable/ic_menu_edit"
                app:startIconTint="#FFC107">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/text_tema_incidencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/incidencia_hint_asunto"
                    android:textColor="@color/white"
                    android:textColorHint="#9E9E9E" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/incidencia_desc"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextLayoutDescripcion"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="#334155"
                app:boxStrokeColor="#FFC107"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/incidencia_hint_desc"
                    android:gravity="top"
                    android:minLines="5"
                    android:textColor="@color/white"
                    android:textColorHint="#9E9E9E" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/incidencia_tipo"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_categorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_bug"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incidencia_tipo_bug"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#334155" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_usuario"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incidencia_tipo_usuario"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#334155" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_juego"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incidencia_tipo_juego"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#334155" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_otros"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/incidencia_tipo_otros"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#334155" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/incidencia_info"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextLayout_info"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#334155"
                app:boxStrokeColor="#FFC107"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_informacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/incidencia_hint_info"
                    android:textColor="@color/white"
                    android:textColorHint="#9E9E9E" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_registrar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:text="@string/incidencia_btn_enviar"
                android:textColor="#000000"
                android:textStyle="bold"
                android:backgroundTint="#FFC107"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
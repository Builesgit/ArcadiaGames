<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/historial_background"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTituloEliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RETIRAR STOCK POR PLATAFORMA"
        android:textColor="#FF5252"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Indique las unidades a retirar de cada sistema"
        android:textColor="#B0BEC5"
        android:gravity="center"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etEliminarPS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="PlayStation"
                android:inputType="number"
                android:textColorHint="#FFFFFF"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_margin="4dp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etEliminarXB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Xbox"
                android:inputType="number"
                android:textColorHint="#FFFFFF"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_margin="4dp"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etEliminarNI"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nintendo"
                android:inputType="number"
                android:textColorHint="#FFFFFF"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_margin="4dp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etEliminarPC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="PC"
                android:inputType="number"
                android:textColorHint="#FFFFFF"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_margin="4dp"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmarRetiro"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="RETIRAR UNIDADES SELECCIONADAS"
        android:backgroundTint="#2196F3"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnEliminarTodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="VACIAR STOCK TOTAL"
        android:backgroundTint="#B71C1C"
        android:textColor="#FFFFFF" />

</LinearLayout>
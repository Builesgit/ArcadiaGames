<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- HEADER -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="414dp"
        android:layout_height="89dp"
        android:background="#334155"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvTituloCesta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/carrito_titulo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFC107"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LISTA PRODUCTOS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutLista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#334155"
        app:cardElevation="6dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toTopOf="@id/layoutResumen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tvCestaVacia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/carrito_vacio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- RESUMEN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutResumen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#334155"
        app:cardElevation="6dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnPay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:text="@string/carrito_precio_total_texto"
                android:textColor="@color/Amarillo"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvTotal"
                android:text="@string/carrito_precio_total"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- BOTON PAGAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPay"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/carrito_btn_proceder_pago"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"
        android:backgroundTint="@color/Amarillo"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="18dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
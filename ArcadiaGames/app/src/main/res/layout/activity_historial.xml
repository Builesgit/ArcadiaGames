<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- HEADER -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="414dp"
        android:layout_height="84dp"
        android:background="#334155"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvHistorialTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="60dp"
        android:text="@string/historial_titulo"
        android:textColor="#FFC107"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TABS (NO CAMBIADAS FUNCIONALMENTE) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabFiltroHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="#FFC107"
        app:tabIndicatorHeight="3dp"
        app:tabTextColor="@android:color/white"
        app:tabSelectedTextColor="#FFC107"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historial_admins" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historial_usuarios" />
    </com.google.android.material.tabs.TabLayout>

    <!-- RECYCLER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabFiltroHistorial"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
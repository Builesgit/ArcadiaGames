<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- HEADER -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="408dp"
        android:layout_height="95dp"
        android:background="#334155"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvTituloGestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/gestion_admins_titulo"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CONTENIDO -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CARD CODIGO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#334155"
                app:cardElevation="6dp"
                android:layout_marginBottom="25dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerarNuevoCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/gestion_admins_codigo_generar"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:backgroundTint="#FFC107"
                        app:cornerRadius="16dp"
                        app:elevation="4dp"/>

                    <TextView
                        android:id="@+id/tvCodigoActivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gestion_admins_codigo_activo"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:layout_marginTop="15dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SUBTITULO LISTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gestion_admins_registrados"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.05"/>

            <!-- CARD LISTA ADMINS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                app:cardBackgroundColor="#334155"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdmins"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"/>

                    <TextView
                        android:id="@+id/tvListaVacia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gestion_admins_no_hay"
                        android:textColor="#66FFFFFF"
                        android:gravity="center"
                        android:layout_marginTop="40dp"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:visibility="gone"/>
                </FrameLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
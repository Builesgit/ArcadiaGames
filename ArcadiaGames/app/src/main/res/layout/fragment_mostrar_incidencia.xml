<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#334155"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titulo_incidencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/mostrar_incidencia_titulo"
            android:textColor="#FFC107"
            android:textSize="20sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subtitulo_incidencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mostrar_incidencia_desc"
            android:textColor="#FFC107"
            android:alpha="0.8"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo_incidencias" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TextLayoutSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="#1E293B"
            app:boxStrokeColor="#FFC107"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#FFC107"
            app:layout_constraintTop_toBottomOf="@id/subtitulo_incidencias">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_bar_catalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/mostrar_incidencia_buscar"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textColorHint="#9E9E9E"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:id="@+id/scrollFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/TextLayoutSearch">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="12dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroTodos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mostrar_incidencia_todos"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#1E293B"
                    app:chipStrokeColor="#44FFFFFF"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroBug"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mostrar_incidencia_bug"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#1E293B"
                    app:chipStrokeColor="#44FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroUsuario"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mostrar_incidencia_usuario"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#1E293B"
                    app:chipStrokeColor="#44FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroJuego"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mostrar_incidencia_juego"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#1E293B"
                    app:chipStrokeColor="#44FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltroOtros"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mostrar_incidencia_otro"
                    android:textColor="@color/white"
                    app:chipSurfaceColor="#1E293B"
                    app:chipStrokeColor="#44FFFFFF"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_catalogo_completo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:paddingBottom="90dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFiltros" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabVerResueltas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:contentDescription="Ver incidencias resueltas"
        android:src="@drawable/ic_archivo"
        app:tint="@android:color/black"
        app:backgroundTint="#FFC107"
        tools:visibility="visible" />

</FrameLayout>
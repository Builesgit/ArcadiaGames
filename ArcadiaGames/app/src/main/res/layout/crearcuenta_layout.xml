<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/crear_cuenta"
    tools:context=".MainActivity">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/fondo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divisor_vertical"
        android:layout_width="3dp"
        android:layout_height="500dp"
        app:dividerColor="@color/Azul_claro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.341" />


    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divisor_horizontal"
        android:layout_width="250dp"
        android:layout_height="3dp"
        app:dividerColor="@color/Azul_claro"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/divisor_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <TextView
        android:id="@+id/level_description_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="12dp"
        android:gravity="center"
        android:text="@string/Crear"
        android:textColor="@color/Azul_claro"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/divisor_horizontal"
        app:layout_constraintStart_toEndOf="@+id/divisor_vertical"
        app:layout_constraintTop_toTopOf="@+id/divisor_vertical"
        app:layout_constraintVertical_bias="0.87"
        />



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TextLayout_Usuario"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/white"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/Usuario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toEndOf="@+id/divisor_vertical"
        app:layout_constraintTop_toTopOf="@id/divisor_horizontal"
        app:layout_constraintVertical_bias="0.05"
        android:background="@drawable/edit_text_background"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TextField_Usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/Morado_Texto"
            app:errorEnabled="true"/>

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TextLayout_Correo"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/white"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/Correo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/TextLayout_Usuario"
        app:layout_constraintTop_toBottomOf="@id/TextLayout_Usuario"
        app:layout_constraintVertical_bias="0.03"
        android:background="@drawable/edit_text_background">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TextField_Correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            app:errorEnabled="true"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TextLayout_Numero"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/white"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/Numero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/TextLayout_Correo"
        app:layout_constraintTop_toBottomOf="@id/TextLayout_Correo"
        app:layout_constraintVertical_bias="0.04"
        android:background="@drawable/edit_text_background">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TextField_Numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            app:errorEnabled="true"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TextLayout_Contraseña"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/white"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/Contraseña"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/TextLayout_Numero"
        app:layout_constraintTop_toBottomOf="@id/TextLayout_Numero"
        app:layout_constraintVertical_bias="0.06"
        android:background="@drawable/edit_text_background">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TextField_Contraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            app:errorEnabled="true"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/TextLayout_CContraseña"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/white"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/Confirmar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/TextLayout_Contraseña"
        app:layout_constraintTop_toBottomOf="@id/TextLayout_Contraseña"
        app:layout_constraintVertical_bias="0.08"
        android:background="@drawable/edit_text_background">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/TextField_CContraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            app:errorEnabled="true"/>

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_crear_cuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Crear"
        android:backgroundTint="@color/Amarillo"
        android:textColor="@color/Texto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/TextLayout_CContraseña"
        app:layout_constraintTop_toBottomOf="@id/TextLayout_CContraseña"
        app:layout_constraintVertical_bias="0.07"
        app:shapeAppearance="@style/RoundedSquare" />

</androidx.constraintlayout.widget.ConstraintLayout>
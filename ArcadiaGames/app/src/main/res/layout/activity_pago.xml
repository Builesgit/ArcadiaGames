<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- HEADER -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="413dp"
        android:layout_height="84dp"
        android:background="#334155"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvTituloPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/pago_titulo"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SCROLL CONTENIDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DETALLES PEDIDO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#334155"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="@string/pago_detalles_pedido"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- IMPORTE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:text="@string/pago_importe"
                            android:textStyle="bold"
                            android:textColor="@color/Amarillo"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvImporteOperacion"
                            android:text="@string/pago_precio_importe"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- COMERCIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:text="@string/pago_comercio"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvComercioOperacion"
                            android:text="@string/pago_nombre_comercio"
                            android:textColor="#FFFFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- PEDIDO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:text="@string/pago_pedido"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvPedidoOperacion"
                            android:text="@string/pago_operacion_pedido"
                            android:textColor="#FFFFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- FECHA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:text="@string/pago_fecha"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvFechaOperacion"
                            android:text="@string/pago_operacion_fecha"
                            android:textColor="#FFFFFF"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- LOGOS TARJETA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:src="@drawable/visa_logo"
                    android:contentDescription="Visa"/>

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/mastercard_logo"
                    android:contentDescription="Mastercard"/>
            </LinearLayout>

            <!-- ENTREGA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#334155"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <RadioGroup
                    android:id="@+id/rgTipoEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbFisico"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recoger en tienda"
                        android:textColor="#FFFFFF"
                        android:buttonTint="@color/Amarillo"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbDigital"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compra Online"
                        android:textColor="#FFFFFF"
                        android:buttonTint="@color/Amarillo" />
                </RadioGroup>

            </androidx.cardview.widget.CardView>

            <!-- DATOS TARJETA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#334155"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/pago_nombre_comprador"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"/>

                    <EditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:hint="@string/pago_numero_tarjeta"
                        android:inputType="number"
                        android:maxLength="19"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etExpiration"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="@string/pago_fecha_expiracion"
                            android:maxLength="5"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#AAAAAA"
                            android:background="@drawable/edittext_background"
                            android:padding="12dp"/>

                        <EditText
                            android:id="@+id/etCvv"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:hint="@string/pago_cvv"
                            android:inputType="numberPassword"
                            android:maxLength="3"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#AAAAAA"
                            android:background="@drawable/edittext_background"
                            android:padding="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_marginTop="20dp"
                        android:text="@string/pago_precio_total"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTON PAGAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/pago_btn_pagar"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:backgroundTint="@color/Amarillo"
                app:cornerRadius="18dp"
                app:elevation="6dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/historial_background"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REPOSICIÓN POR PLATAFORMA"
        android:textColor="#FFC107"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etStockPS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="PlayStation"
            android:textColorHint="#FFFFFF"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:background="@drawable/edittext_background"
            android:padding="14dp"
            android:layout_margin="4dp"
            android:gravity="center"/>

        <EditText
            android:id="@+id/etStockXbox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Xbox"
            android:textColorHint="#FFFFFF"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:background="@drawable/edittext_background"
            android:padding="14dp"
            android:layout_margin="4dp"
            android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etStockNintendo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nintendo"
            android:textColorHint="#FFFFFF"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:background="@drawable/edittext_background"
            android:padding="14dp"
            android:layout_margin="4dp"
            android:gravity="center"/>

        <EditText
            android:id="@+id/etStockPC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="PC"
            android:textColorHint="#FFFFFF"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:background="@drawable/edittext_background"
            android:padding="14dp"
            android:layout_margin="4dp"
            android:gravity="center"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmarSuma"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="ACTUALIZAR INVENTARIO"
        android:backgroundTint="#4CAF50"
        android:textColor="#000000"
        android:textStyle="bold"/>
</LinearLayout>
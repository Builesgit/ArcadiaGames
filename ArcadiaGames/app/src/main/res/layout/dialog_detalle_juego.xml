<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_popup_negro"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_detalle_imagen"
        android:layout_width="110dp"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <TextView
        android:id="@+id/tv_detalle_nombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_detalle_imagen"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_detalle_plataforma"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#00FF00"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_detalle_nombre"
        app:layout_constraintTop_toBottomOf="@id/tv_detalle_nombre" />

    <TextView
        android:id="@+id/tv_detalle_precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tv_detalle_nombre"
        app:layout_constraintTop_toBottomOf="@id/tv_detalle_plataforma" />

    <TextView
        android:id="@+id/tv_detalle_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tv_detalle_nombre"
        app:layout_constraintTop_toBottomOf="@id/tv_detalle_precio" />

    <TextView
        android:id="@+id/tv_detalle_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/iv_detalle_imagen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_detalle_descripcion"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_alquilar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/Alquilar"
            android:textColor="@color/white"
            app:strokeColor="@color/white"
            app:shapeAppearance="@style/ShapeAppearance.RoundedSquare"/>

        <Button
            android:id="@+id/btn_comprar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/Texto_Verde"
            android:text="@string/Comprar"
            android:textColor="@color/white"
            app:shapeAppearance="@style/ShapeAppearance.RoundedSquare"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
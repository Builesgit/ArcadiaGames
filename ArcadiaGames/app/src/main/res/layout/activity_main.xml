<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_screen_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- FONDO -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/fondo_sin_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />




        <!-- PANEL NEGRO (AHORA VA DETRÁS DE LAS LÍNEAS) -->
        <View
            android:id="@+id/panel_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#AA000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="185dp"
            android:layout_height="167dp"
            android:layout_marginTop="50dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_sin_fondo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- LINEA AMARILLA VERTICAL -->
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divisor_vertical"
            android:layout_width="3dp"
            android:layout_height="350dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="30dp"
            app:dividerColor="@color/Amarillo"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- LINEA HORIZONTAL -->
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divisor_horizontal"
            android:layout_width="220dp"
            android:layout_height="3dp"
            android:layout_marginTop="40dp"
            app:dividerColor="@color/Amarillo"
            app:layout_constraintTop_toTopOf="@id/divisor_vertical"
            app:layout_constraintStart_toEndOf="@id/divisor_vertical"/>

        <!-- TITULO -->
        <TextView
            android:id="@+id/level_description_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_inicio"
            android:textColor="@color/Amarillo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@id/divisor_horizontal"
            app:layout_constraintStart_toEndOf="@id/divisor_vertical"/>

        <!-- CORREO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TextLayout_Usuario"
            style="?attr/textInputFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/login_correo"
            app:boxBackgroundColor="@color/white"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divisor_horizontal"
            app:layout_constraintStart_toEndOf="@id/divisor_vertical"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtUsuario"
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@android:color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TextLayout_Contraseña"
            style="?attr/textInputFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/login_password"
            app:endIconMode="password_toggle"
            app:boxBackgroundColor="@color/white"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/TextLayout_Usuario"
            app:layout_constraintStart_toStartOf="@id/TextLayout_Usuario"
            app:layout_constraintEnd_toEndOf="@id/TextLayout_Usuario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPassword"
                android:layout_width="310dp"
                android:layout_height="match_parent"
                android:inputType="textPassword"
                android:textColor="@android:color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- BOTON LOGIN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_acceder"
            android:backgroundTint="@color/Amarillo"
            android:textColor="@android:color/black"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/TextLayout_Contraseña"
            app:layout_constraintStart_toStartOf="@id/TextLayout_Contraseña"/>

        <!-- REGISTRARSE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarse"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_registrate"
            android:textColor="@color/Amarillo"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="@id/btnLogin"/>

        <LinearLayout
            android:id="@+id/languageSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/flagSpanish"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="8dp"
                android:src="@drawable/espana"/>

            <ImageView
                android:id="@+id/flagEnglish"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="8dp"
                android:src="@drawable/ingles"/>

            <ImageView
                android:id="@+id/flagFrench"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="8dp"
                android:src="@drawable/francia"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

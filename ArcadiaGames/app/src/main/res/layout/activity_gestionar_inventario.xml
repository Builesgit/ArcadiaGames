<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B"
    tools:context=".GestionarInventarioActivity">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#334155"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_titulo_gestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="@string/inventario_titulo"
        android:textColor="#FFC107"
        android:textSize="20sp"
        android:letterSpacing="0.05"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtitulo_gestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inventario_subtitulo"
        android:textColor="#FFC107"
        android:alpha="0.8"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_titulo_gestion"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_gestion" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inventario_gestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground" />

    <ProgressBar
        android:id="@+id/progressBarGestion"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:indeterminateTint="#FFC107"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
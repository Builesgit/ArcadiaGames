<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Prueba1Integrador" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/Azul_claro</item>
        <item name="android:statusBarColor">@color/Azul_Oscuro</item>

    </style>

    <style name="Theme.Prueba1Integrador" parent="Base.Theme.Prueba1Integrador" />

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/Azul_Fondo_Botones</item>

        <item name="android:colorBackground">@color/Azul_Fondo_Botones</item>

        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>

        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>

        <item name="colorAccent">@color/Amarillo</item>
        <item name="android:colorAccent">@color/Amarillo</item>
    </style>

    <style name="ShapeAppearance.App.Carousel" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="BotonMenuPersonalizado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">65dp</item>
        <item name="android:layout_marginBottom">12dp</item>

        <!-- <item name="android:background">@drawable/fondo_boton_perfil</item>-->
        <item name="android:backgroundTint">#121212</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        
        <item name="iconTint">#FFFFFF</item>
        <item name="iconPadding">15dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">28dp</item>
    </style>

    <style name="CircleAppearance">
        <item name="cornerSize">50%</item>
    </style>
</resources>